---
import PageHeader from "../components/PageHeader.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page Not Found">
    <div class="container">
        <PageHeader title="Page not found" />

        <p>Not all those who wander are lost, but you are.</p>
        <a href="/" class="btn">Back to home</a>
    </div>
</Layout>

<style lang="scss">
    .container {
        max-width: 75ch;
        font-size: #{utils.makeClamp(14, 16)};
        text-align: center;
        padding-bottom: 20vw;
    }
    h2 {
        font-family: var(--ff-josefin-sans--regular);
        font-size: #{utils.makeClamp(24, 36)};
    }
</style>
