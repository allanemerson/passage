<style is:global lang="scss">
  :root {
    --color-black: #1a1609;
    --color-gold: #9f8b57;
    --color-light-gold: #dbc273;
    --color-light-gray: #4d4c48;
    --color-gray: #181818;
    --block-padding: 30px;
    --navbar-height: 72px;
    --vibe-images-width: 40vw;
    --gutter: 24px;
    --arrow-size: 30px;
    --swiper-theme-color: var(--color-gold);
    @media (min-width: #{utils.getBreakpoint('lg')}) {
      --navbar-height: 110px;
      --block-padding: 100px;
      --vibe-images-width: 500px;
      --gutter: 30px;
      --arrow-size: 50px;
    }
  }
  * {
    box-sizing: border-box;
  }
  html {
    scroll-behavior: smooth;
    scroll-padding-top: var(--navbar-height);
  }
  body {
    overflow-x: hidden;
    margin: 0;
    padding: 0;
    background: var(--color-black);
    font-family: var(--ff-josefin-sans--regular);
    font-size: #{utils.makeClamp(16, 21)};
    line-height: 1.5;
    color: white;
    -moz-osx-font-smoothing: grayscale;
    -webkit-font-smoothing: antialiased;

    &.nav-open {
      .navigation {
        left: 0;
      }
    }
  }
  .hidden-lg {
    @media (min-width: #{utils.getBreakpoint('lg')}) {
      display: none;
    }
  }
  .hidden-xs {
    @media (max-width: #{utils.getMaxBreakpoint('lg')}) {
      display: none;
    }
  }
  .visually-hidden {
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    height: 1px;
    overflow: hidden;
    position: absolute;
    white-space: nowrap;
    width: 1px;
  }
  .container {
    margin-inline: auto;
    max-width: var(--container-max-width, 1400px);
    padding-inline: var(--gutter);
  }
  h2,
  h3,
  h4,
  h5,
  h6 {
    margin-top: 0;
  }

  h1,
  h2 {
    font-family: var(--ff-manchester--regular);
    font-weight: 400;
    text-align: center;
    line-height: 1;
    margin: 0;
  }

  h1 {
    font-size: #{utils.makeClamp(90, 120)};
  }
  h2 {
    font-size: #{utils.makeClamp(70, 100)};
  }
  h3 {
    font-size: #{utils.makeClamp(24, 36)};
  }
  h4 {
    font-size: #{utils.makeClamp(18, 24)};
  }

  p,
  ol,
  ul,
  table,
  figure,
  picture {
    margin-block: 1.5em;
  }

  em {
    font-family: var(--ff-josefin-sans--italic);
    font-style: normal;
  }

  strong {
    font-family: var(--ff-josefin-sans--bold);
    font-style: normal;
  }

  img,
  svg {
    max-width: 100%;
    height: auto;
    display: block;
  }
  a {
    color: var(--color-gold);
    text-decoration: none;
    &:hover {
      color: var(--color-light-gold);
    }
  }
  a,
  button {
    transition: 0.2s;
    -webkit-appearance: none;
    border: none;
    padding: 0;
    background: none;
  }
  section {
    padding-block: var(--block-padding);
    position: relative;
  }
  .action-bar {
    display: flex;
    justify-content: center;
    gap: var(--gutter);
    align-items: center;
    margin-top: var(--gutter);
    flex-direction: column;

    @media (min-width: #{utils.getBreakpoint('lg')}) {
      flex-direction: row;
    }

    p {
      margin: 0;
    }
  }
  .btn {
    background: var(--color-gold);
    padding: 0.875em 1em 0.75em;
    color: black;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 5px;
    gap: 1ex;
    line-height: 1;

    &:hover {
      background: var(--color-light-gold);
      color: black;
      cursor: pointer;
    }

    &--secondary {
      background: transparent;
      border: solid 1px rgb(255 255 255 / 0.25);
      color: var(--color-gold);

      @media (hover: hover) {
        &:hover {
          color: var(--color-gold);
          border-color: var(--color-gold);
          background: rgb(255 255 255 / 0.05);
        }
      }
    }

    svg,
    img {
      height: 1em;
      width: auto;
      transform: translateY(-2px);
    }
  }
  footer {
    text-align: center;
    padding: var(--gutter);
    font-size: #{utils.makeRem(14)};
    gap: 10px;

    svg {
      width: 20px;
    }
  }
</style>
