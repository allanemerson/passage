---
import { getImage } from "astro:assets";
import bg from "../assets/images/bg-artists.webp";

const optimizedBg = await getImage({ src: bg });
const artists: string[] = [];
---

<section
  id="artists"
  class="artists"
  style={`--bgUrl: url(${optimizedBg.src});`}
>
  <div class="container">
    <h2>Line-up</h2>
    {
      artists.length > 0 && (
        <ul class="artists-list">
          {artists.map((artist) => (
            <li>{artist}</li>
          ))}
        </ul>
      )
    }
    {artists.length === 0 && <p class="placeholder">Coming soon!</p>}
  </div>
</section>

<style lang="scss">
  .artists {
    background: var(--bgUrl) center center no-repeat;
    background-size: cover;
    min-height: 60vh;
    display: flex;
    align-items: center;

    @media (min-width: #{utils.getBreakpoint('lg')}) {
      background-attachment: fixed;
    }

    &::before {
      content: "";
      width: 100%;
      height: 100%;
      position: absolute;
      z-index: 1;
      left: 0;
      top: 0;
      background: rgba(0, 0, 0, 0.2);
    }

    .container {
      position: relative;
      z-index: 2;
    }

    text-align: center;
  }

  .artists-list {
    @include utils.resetList;
    display: flex;
    gap: 2em 3em;
    flex-wrap: wrap;
    justify-content: center;
    font-size: #{utils.makeRem(25)};
    text-shadow: 0 0px 20px rgba(0, 0, 0, 0.9);
    margin-bottom: 3rem;
  }

  .placeholder {
    font-size: #{utils.makeClamp(21, 24)};
    color: white;
  }
</style>
