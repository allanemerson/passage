---
import { Image, getImage } from "astro:assets";
import hand from "../assets/images/hand.svg";
import bg from "../assets/images/bg-about.jpg";

const optimizedBg = await getImage({ src: bg });
---

<section id="about" class="about" style={`--bgUrl: url(${optimizedBg.src});`}>
  <h2>About</h2>
  <div class="container">
    <div class="img">
      <Image src={hand} alt="" role="presentation" />
    </div>
    <div class="content">
      <p>
        Passage is a boutique music festival. But it is also a moment. A deep
        breath of mindfulness. A milestone to mark the story of your journey
        with genuine, joyful human connection.
      </p>
      <p>
        We hope that the experiences had on this wild 30 acres of woodland in
        rural Alabama are a conscious turning of a page for you as it has been
        for many of us; a Passage from one chapter to the next. Our intentions
        are powerful, and if we consciously set them for growth, understanding,
        and rebirth, we can manifest them.
      </p>
      <p>
        From joyful, ecstatic house music to deeply tribal rhythms from beyond
        the bounds of time, we use sound as a catalyst for it all.
      </p>
      <p><em>See you in the woods.</em></p>
    </div>
  </div>
</section>

<style lang="scss">
  .about {
    background: var(--bgUrl) center center no-repeat;
    background-size: cover;
    color: var(--color-light-gold);
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.9);

    @media (min-width: #{utils.getBreakpoint('lg')}) {
      background-attachment: fixed;
    }

    &::before {
      content: "";
      width: 100%;
      height: 100%;
      position: absolute;
      z-index: 1;
      left: 0;
      top: 0;
      background: rgba(0, 0, 0, 0.3);
    }
  }

  .container {
    position: relative;
    z-index: 2;

    @media (min-width: #{utils.getBreakpoint('lg')}) {
      display: flex;
      gap: 75px;

      .img {
        width: 321px;
      }

      .content {
        flex: 1;
      }
    }
  }

  h2 {
    color: white;
  }

  .img {
    width: 30vw;
    margin-inline: auto;
  }

  p {
    &:last-child {
      font-size: #{utils.makeClamp(21, 24)};
      color: white;
    }
  }
</style>
