---
import FacebookIcon from "../assets/icons/facebook.svg";
import DiscordIcon from "../assets/icons/discord.svg";
import Ticket from "../assets/icons/ticket.svg";
import logo from "../assets/images/logo.webp";

const pathname = new URL(Astro.request.url).pathname;

import { TICKET_LINK, FACEBOOK_URL, DISCORD_URL } from "../constants.ts";
import { Image } from "astro:assets";
const navItems = [
    { name: "About", href: "/#about" },
    { name: "Gallery", href: "/#gallery" },
    { name: "Property", href: "/property" },
    { name: "Admission", href: "/admission/" },
    { name: "Schedule", href: "/schedule" },
    { name: "FAQ", href: "/faq/" },
];
---

<header class="header">
    <div class="container">
        <div class="header__layout">
            <a class="logo" href="/">
                <Image src={logo} alt="Passage Gathering logo" width="210" height="70" />
            </a>
            <nav class="navigation">
                <ul class="navigation__items">
                    {
                        navItems.map((item) => (
                            <li class="navigation__item">
                                <a
                                    href={item.href}
                                    class:list={["navigation__link", { active: pathname === item.href }]}>
                                    {item.name}
                                </a>
                            </li>
                        ))
                    }

                    <li class="navigation__item hidden-lg">
                        <a
                            class="navigation__link navigation__link--icon"
                            href={FACEBOOK_URL}
                            target="_blank"
                            title="Facebook event page">
                            <FacebookIcon />
                            Event Page
                        </a>
                    </li>
                    <li class="navigation__item hidden-lg">
                        <a
                            class="navigation__link navigation__link--icon"
                            href={DISCORD_URL}
                            target="_blank"
                            title="Join the Discord">
                            <DiscordIcon />
                            Join the Discord
                        </a>
                    </li>
                    <li class="navigation__item hidden-lg">
                        <a class="btn navigation__link--action" href={TICKET_LINK} target="_blank">
                            <Ticket />
                            Tickets
                        </a>
                    </li>
                </ul>
            </nav>
            <nav class="navigation-actions">
                <ul class="navigation-actions__items">
                    <li class="navigation-actions__item">
                        <a class="navigation-actions__link" href={FACEBOOK_URL} target="_blank">
                            <span class="visually-hidden">Facebook event page</span>
                            <FacebookIcon />
                        </a>
                    </li>
                    <li class="navigation-actions__item">
                        <a class="navigation-actions__link" href={DISCORD_URL} target="_blank">
                            <span class="visually-hidden">Join the Discord</span>
                            <DiscordIcon />
                        </a>
                    </li>
                    <!-- <li class="navigation__item">
            <a
              class="navigation__link"
              href="https://docs.google.com/spreadsheets/d/1aBzXIBJMr7JS7kcla6vfZBKIlOOPI0spbcThHT6LRmk/edit?gid=0#gid=0"
              target="_blank">Volunteer Sign Up</a
            >
          </li> -->
                    <li class="navigation-actions__item hidden-xs">
                        <a class="btn" href={TICKET_LINK} target="_blank">
                            <Ticket />
                            Tickets
                        </a>
                    </li>
                </ul>
            </nav>
            <button class="navigation-toggle">
                <svg aria-label="menu" width="16" height="15" viewBox="0 0 16 15" xmlns="http://www.w3.org/2000/svg">
                    <g fill="currentColor" fill-rule="evenodd">
                        <path d="M0 0h16v2H0zM0 6.007h16v2H0zM0 12.015h16v2H0z"></path>
                    </g>
                </svg>
            </button>
        </div>
    </div>
</header>

<style lang="scss">
    .header {
        position: sticky;
        top: 0;
        padding-block: 20px;
        z-index: 1000;
        isolation: isolate;
        min-height: var(--navbar-height);
        place-content: center;
        &::before {
            content: "";
            background: hsl(from var(--color-black) h s l / 0.9);
            backdrop-filter: blur(3px);
            position: absolute;
            inset: 0;
            z-index: -1;
        }
        &__layout {
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
    }
    .logo {
        width: min(25vw, 210px);
    }
    .navigation-toggle {
        display: flex;
        align-items: baseline;
        gap: 0.5em;
        color: var(--color-gold);
        @media (min-width: #{utils.getBreakpoint('lg')}) {
            display: none;
        }
    }
    .navigation {
        @media (max-width: #{utils.getMaxBreakpoint('lg')}) {
            position: fixed;
            top: var(--navbar-height);
            padding-inline: var(--gutter);
            transition: 0.3s ease-out;
            width: 100vw;
            background: var(--color-black);
            height: 100dvh;
            z-index: 100;
            left: 100%;
        }
    }

    .navigation__items {
        @include utils.resetList;

        display: grid;
        align-items: start;
        gap: 0.5em;
        @media (min-width: #{utils.getBreakpoint('lg')}) {
            display: flex;
            align-items: center;
            justify-content: center;
            position: static;
            height: auto;
            padding: 0;
            width: auto;
            gap: 10px;
        }
    }
    .navigation__link {
        color: var(--color-light-gold);
        text-decoration: none;
        display: flex;
        gap: 0.5em;
        align-items: baseline;
        padding: 0.5em 0.75em 0.25em;
        border-radius: 5px;
        font-size: #{utils.makeClamp(16, 18)};
        &:focus {
            outline: none;
        }

        &.active,
        &:hover {
            background: hsl(from var(--color-gold) h s l / 0.2);
        }

        svg {
            height: 1em;
        }

        &--action {
            background: var(--color-gold);
            @media (max-width: #{utils.getMaxBreakpoint('lg')}) {
                width: 100%;
            }
            @media (hover: hover) {
                &:hover {
                    color: black;
                    background: var(--color-light-gold);
                }
            }
        }
    }

    .navigation-actions {
        @media (max-width: #{utils.getMaxBreakpoint('lg')}) {
            display: none;
        }
        &__items {
            @include utils.resetList;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 1em;
        }
        &__link {
            color: var(--color-gold);
            display: flex;
            align-items: baseline;
            gap: 10px;
            @media (hover: hover) {
                &:hover {
                    color: var(--color-light-gold);
                }
            }
            svg {
                height: 1em;
                display: block;
            }
        }
    }
</style>

<script>
    (function () {
        if (window.location.pathname !== "/") return;

        const navLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.navigation__link[href^="/#"]'));

        function getActiveSection(): string | null {
            const threshold = window.innerHeight * 0.25;
            let active: string | null = null;
            for (const link of navLinks) {
                const id = link.getAttribute("href")!.slice(2);
                const el = document.getElementById(id);
                if (!el) continue;
                if (el.getBoundingClientRect().top <= threshold) {
                    active = id;
                }
            }
            return active;
        }

        function updateNav(): void {
            const active = getActiveSection();
            navLinks.forEach((link) => link.classList.remove("active"));

            if (active) {
                document
                    .querySelector<HTMLAnchorElement>(`.navigation__link[href="/#${active}"]`)
                    ?.classList.add("active");
            }
        }

        let ticking = false;
        window.addEventListener(
            "scroll",
            () => {
                if (!ticking) {
                    requestAnimationFrame(() => {
                        updateNav();
                        ticking = false;
                    });
                    ticking = true;
                }
            },
            { passive: true },
        );

        updateNav();
        requestAnimationFrame(updateNav);
    })();

    const toggle = document.querySelector(".navigation-toggle");
    const navLinks = document.querySelectorAll(".navigation__link");
    toggle?.addEventListener("click", (e) => {
        e.preventDefault();
        document.body.classList.toggle("nav-open");
    });
    navLinks.forEach((link) => {
        link.addEventListener("click", () => {
            document.body.classList.remove("nav-open");
        });
    });
</script>
