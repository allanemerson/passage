---
const { title } = Astro.props;
---

<header class="page-header">
  <h1 class="page-header__title">{title}</h1>
  <div class="page-header__description">
    <slot />
  </div>
</header>

<style lang="scss">
  .page-header {
    margin-block: #{utils.makeClamp(40, 90)};
    &__title {
      margin: 0;
    }
    &__description {
      text-align: center;
      max-width: 70ch;
      margin-inline: auto;
    }
  }
</style>
