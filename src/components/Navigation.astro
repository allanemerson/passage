---
import FacebookIcon from "../assets/icons/facebook.svg";
import DiscordIcon from "../assets/icons/discord.svg";
import Ticket from "../assets/icons/ticket.svg";

const pathname = new URL(Astro.request.url).pathname;

import { TICKET_LINK, FACEBOOK_URL, DISCORD_URL } from "../constants.ts";
const navItems = [
  { name: "Home", href: "/" },
  { name: "About", href: "/#about" },
  { name: "Line-up", href: "/#artists" },
  { name: "Gallery", href: "/#gallery" },
  { name: "Tickets", href: "/tickets/" },
  { name: "FAQ", href: "/faq/" },
];
---

<nav class="navigation">
  <div class="container">
    <button class="navigation-toggle">
      <svg
        width="16"
        height="15"
        viewBox="0 0 16 15"
        xmlns="http://www.w3.org/2000/svg"
      >
        <g fill="currentColor" fill-rule="evenodd">
          <path d="M0 0h16v2H0zM0 6.007h16v2H0zM0 12.015h16v2H0z"></path>
        </g>
      </svg>
      Menu
    </button>
    <ul class="navigation-items">
      {
        navItems.map((item) => (
          <li class="navigation-item">
            <a
              href={item.href}
              class:list={[
                "navigation-link",
                { active: pathname === item.href },
              ]}
            >
              {item.name}
            </a>
          </li>
        ))
      }

      <li class="navigation-item hidden-lg">
        <a
          class="navigation-link navigation-link--icon"
          href={FACEBOOK_URL}
          target="_blank"
          title="Facebook event page"
        >
          <FacebookIcon />
          Event Page
        </a>
      </li>
      <li class="navigation-item hidden-lg">
        <a
          class="navigation-link navigation-link--icon"
          href={DISCORD_URL}
          target="_blank"
          title="Join the Discord"
        >
          <DiscordIcon />
          Join the Discord
        </a>
      </li>
    </ul>
    <ul class="navigation-actions">
      <li class="navigation-item hidden-xs">
        <a
          class="navigation-link navigation-link--icon"
          href={FACEBOOK_URL}
          target="_blank"
          title="Facebook event page"
        >
          <FacebookIcon />
        </a>
      </li>
      <li class="navigation-item hidden-xs">
        <a
          class="navigation-link navigation-link--icon"
          href={DISCORD_URL}
          target="_blank"
          title="Join the Discord"
        >
          <DiscordIcon />
        </a>
      </li>
      <!-- <li class="navigation-item">
        <a
          class="navigation-link"
          href="https://docs.google.com/spreadsheets/d/1aBzXIBJMr7JS7kcla6vfZBKIlOOPI0spbcThHT6LRmk/edit?gid=0#gid=0"
          target="_blank">Volunteer Sign Up</a
        >
      </li> -->
      <li class="navigation-item">
        <a
          class="btn navigation-link--action"
          href={TICKET_LINK}
          target="_blank"
        >
          <Ticket />
          Buy Tickets
        </a>
      </li>
    </ul>
  </div>
</nav>

<style lang="scss">
  .navigation-toggle {
    display: flex;
    align-items: baseline;
    gap: 0.5em;
    @media (min-width: #{utils.getBreakpoint('lg')}) {
      display: none;
    }
  }
  .navigation {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    background: var(--color-gold);
    z-index: 1000;
    font-size: #{utils.makeRem(18)};
  }
  .container {
    height: var(--navbar-height);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .navigation-items {
    @include utils.resetList;
    position: fixed;
    top: var(--navbar-height);
    right: 100%;
    padding: var(--gutter);
    background: var(--color-gold) url("/assets/images/hand-light.svg") center
      center no-repeat;
    background-size: cover;
    transition: 0.3s ease-out;
    width: 100vw;
    height: calc(100vh - var(--navbar-height));
    z-index: 100;
    box-sizing: border-box;
    @media (min-width: #{utils.getBreakpoint('lg')}) {
      display: flex;
      align-items: center;
      justify-content: center;
      position: static;
      height: auto;
      padding: 0;
      width: auto;
      background: var(--color-gold);
      gap: 10px;
    }
  }
  .navigation-link {
    color: black;
    text-decoration: none;
    display: flex;
    gap: 4px;
    align-items: center;
    padding: 0.5em 0.75em 0.25em;
    border-radius: 5px;
    &--icon {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 5px;
    }

    &:focus {
      outline: none;
    }

    &.active,
    &:hover {
      background: rgba(255, 255, 255, 0.4);
    }

    svg {
      height: 1em;
      display: block;
    }
  }

  .navigation-actions {
    @include utils.resetList;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }
  .navigation-link--action {
    background: rgba(255, 255, 255, 0.5);

    @media (hover: hover) {
      &:hover {
        color: black;
        background: var(--color-light-gold);
      }
    }
  }
</style>

<script>
  (function () {
    if (window.location.pathname !== "/") return;

    const navLinks = Array.from(
      document.querySelectorAll<HTMLAnchorElement>(
        '.navigation-link[href^="/#"]',
      ),
    );
    const homeLink = document.querySelector<HTMLAnchorElement>(
      '.navigation-link[href="/"]',
    );

    function getActiveSection(): string | null {
      const threshold = window.innerHeight * 0.25;
      let active: string | null = null;
      for (const link of navLinks) {
        const id = link.getAttribute("href")!.slice(2);
        const el = document.getElementById(id);
        if (!el) continue;
        if (el.getBoundingClientRect().top <= threshold) {
          active = id;
        }
      }
      return active;
    }

    function updateNav(): void {
      const active = getActiveSection();
      navLinks.forEach((link) => link.classList.remove("active"));
      homeLink?.classList.remove("active");

      if (active) {
        document
          .querySelector<HTMLAnchorElement>(
            `.navigation-link[href="/#${active}"]`,
          )
          ?.classList.add("active");
      } else {
        homeLink?.classList.add("active");
      }
    }

    let ticking = false;
    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          requestAnimationFrame(() => {
            updateNav();
            ticking = false;
          });
          ticking = true;
        }
      },
      { passive: true },
    );

    updateNav();
    requestAnimationFrame(updateNav);
  })();

  const toggle = document.querySelector(".navigation-toggle");
  const navLinks = document.querySelectorAll(".navigation-link");
  toggle?.addEventListener("click", (e) => {
    e.preventDefault();
    document.body.classList.toggle("nav-open");
  });
  navLinks.forEach((link) => {
    link.addEventListener("click", () => {
      document.body.classList.remove("nav-open");
    });
  });
</script>
